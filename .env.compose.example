# Docker Compose configuration for mud-web-proxy.
#
#   cp .env.compose.example .env
#
# Two kinds of setting live here:
#
#   MWP_*      compose and Caddy concerns (hostname, certificate contact,
#              which image to run).
#   everything Proxy configuration, under the exact names documented in
#   else       docs/configuration.md. The proxy service loads this file, so
#              any variable from that reference works here without needing
#              to be added to compose.yaml first.
#
# The required values below are deliberately EMPTY. compose.yaml declares
# them with ${VAR:?...}, so `docker compose up` fails with a named error
# until each one is filled in. An example that starts successfully with
# placeholder values is an example that reaches production unedited.

# --- Required: Caddy --------------------------------------------------------

# Public hostname. Must already resolve to this host: Caddy requests a
# certificate for it on first start, and an unresolvable name fails the ACME
# challenge rather than falling back to plaintext.
MWP_DOMAIN=

# Contact address for the Let's Encrypt account. Used for expiry warnings.
MWP_ACME_EMAIL=

# --- Required: proxy target -------------------------------------------------

# The MUD this proxy fronts. Required because the built-in default is a real
# third-party server (muds.maldorne.org); leaving it unset would start a
# proxy pointed at someone else's MUD instead of failing.
TN_HOST=

# Defaults to 4000.
#TN_PORT=4000

# --- Optional: target policy ------------------------------------------------

# fixed (default) restricts every client to TN_HOST:TN_PORT.
#
# The other modes have their own mandatory settings, and the proxy refuses
# to start without them rather than falling back to something permissive.
# Read docs/configuration.md before changing this.
#TARGET_MODE=fixed

# Required when TARGET_MODE=allowlist. Comma-separated host:port entries.
# An empty or unparseable list is a startup error, not "allow everything".
#ALLOWED_TARGETS=aardmud.org:4000,achaea.com:23

# Required when TARGET_MODE=arbitrary, which lets a client name any host.
# Both of the following are mandatory in that mode:
#
#   1. ARBITRARY_ALLOWED_PORTS — ports or ranges the client may reach.
#ARBITRARY_ALLOWED_PORTS=23,4000-4100
#
#   2. An enforced authentication mode, so the proxy is not an open relay.
#      Either a shared secret of at least 32 bytes:
#AUTH_MODE=shared-secret
#PROXY_SHARED_SECRET=
#
#      or App Attest, for iOS clients:
#REQUIRE_APP_AUTH=true
#APPATTEST_BUNDLE_ID=
#APPATTEST_TEAM_ID=

# --- Optional: image --------------------------------------------------------

# Digest-pinned published image. Left unset, the stack builds from source.
#MWP_IMAGE=ghcr.io/andrewgoldfinch/mud-web-proxy@sha256:...
