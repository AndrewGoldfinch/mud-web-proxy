# Docker Compose configuration for mud-web-proxy.
#
#   cp .env.compose.example .env
#
# MWP_* settings configure Compose and Caddy. The proxy settings below use the
# same names as docs/configuration.md. MWP_DOMAIN and MWP_ACME_EMAIL are
# required by compose.yaml; MWP_IMAGE is optional.

MWP_DOMAIN=
MWP_ACME_EMAIL=
# MWP_IMAGE=ghcr.io/andrewgoldfinch/mud-web-proxy@sha256:...

# --- Listener ---------------------------------------------------------------
# compose.yaml's service-level environment block imposes BIND_HOST,
# INBOUND_TLS_MODE, ALLOW_INSECURE_INBOUND_NO_TLS, and TRUSTED_PROXY_CIDRS;
# .env cannot change them.
# BIND_HOST=0.0.0.0
WS_PORT=6200
# Must remain 6200 in this supplied topology unless Caddy and the Compose
# healthcheck change with it.

# --- Inbound TLS ------------------------------------------------------------
# INBOUND_TLS_MODE=off
# TLS_CERT_PATH=./cert.pem
# TLS_KEY_PATH=./privkey.pem
# ALLOW_INSECURE_INBOUND_NO_TLS=true

# --- Telnet target and target policy ----------------------------------------
# Compose deliberately requires the operator to choose a target.
TN_HOST=
TN_PORT=5010
TARGET_MODE=fixed
# ALLOWED_TARGETS=aardmud.org:4000,achaea.com:23
# Arbitrary targets can make this proxy an SSRF relay; use only with enforced
# authentication and a narrow port list.
# ARBITRARY_ALLOWED_PORTS=23,4000-4100
MUD_TLS_MODE=prefer

# --- Authentication ---------------------------------------------------------
AUTH_MODE=none
# PROXY_SHARED_SECRET=
# Query-string secrets leak to access logs and referrers; leave this disabled
# unless a browser client cannot use another authentication path.
# AUTH_ALLOW_QUERY_SECRET=false
# REQUIRE_APP_AUTH=false

# --- Origin checking --------------------------------------------------------
# ALLOWED_ORIGINS=https://app.example.com
# ALLOW_MISSING_ORIGIN=false

# --- Trusted proxies --------------------------------------------------------
# compose.yaml limits forwarded-header trust to Caddy on this stack's subnet,
# so a client cannot supply its own X-Forwarded-For and be believed.
# TRUSTED_PROXY_CIDRS=172.28.0.0/24

# --- Session limits ---------------------------------------------------------
SESSION_TIMEOUT_HOURS=24
MAX_SESSIONS_PER_DEVICE=5
MAX_SESSIONS_PER_IP=10
# MAX_SESSIONS_GLOBAL=100
RESUME_GRACE_MINUTES=45

# --- Message rate -----------------------------------------------------------
MAX_MESSAGES_PER_SECOND=60
MAX_MESSAGES_PER_SECOND_PER_IP=240

# --- Shutdown ---------------------------------------------------------------
SHUTDOWN_GRACE_MS=3000
SHUTDOWN_DEADLINE_MS=15000

# --- Telnet byte caps -------------------------------------------------------
MAX_SUBNEGOTIATION_BYTES=65536
OUTPUT_BUFFER_BYTES=51200

# --- WebSocket liveness -----------------------------------------------------
WS_HEARTBEAT_ENABLED=true
WS_HEARTBEAT_INTERVAL_MS=30000
WS_HEARTBEAT_TIMEOUT_MS=90000

# --- Diagnostics and logging ------------------------------------------------
ENABLE_DIAGNOSTICS=false
# ADMIN_TOKEN=
LOG_LEVEL=info
# NO_COLOR=1

# --- App Attest (optional, off by default) ----------------------------------
# App Attest is Apple-device-only. Its attestation and assertion verification
# have not received an independent cryptographic review; do not rely on it as
# the only access control.
# APPATTEST_BUNDLE_ID=com.example.yourapp
# APPATTEST_TEAM_ID=AAABBBCCC1
# Enabling App Attest requires compose.appattest.yaml, which mounts this
# directory writable.
# ATTESTED_KEYS_PATH=/var/lib/mud-web-proxy/attested-keys.json

# --- APNS push (optional, off by default) -----------------------------------
# Push stores device tokens in memory and sends alert snippets of MUD output
# through Apple's servers. Leave these unset unless that data flow is intended.
# APNS_KEY_PATH=./AuthKey.p8
# APNS_KEY_ID=
# APNS_TEAM_ID=
# APNS_TOPIC=com.example.yourapp
APNS_ENVIRONMENT=sandbox
# APNS_TEST_SECRET=

# --- Background push tuning -------------------------------------------------
# SILENT_PUSH_INTERVAL_MS=1200000
# ACTIVITY_PUSH_INTERVAL_MS=120000
# ACTIVITY_PUSH_ACK_TIMEOUT_MS=15000
# ACTIVITY_PUSH_FALLBACK_COOLDOWN_MS=60000
# ACTIVITY_PUSH_FALLBACK_MAX_PER_HOUR=6
# ACTIVITY_PUSH_MAX_SNIPPET_LENGTH=100
