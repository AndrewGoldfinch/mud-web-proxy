# Docker Compose configuration for mud-web-proxy.
#
#   cp .env.compose.example .env
#
# The required values below are deliberately EMPTY. compose.yaml declares
# them with ${VAR:?...}, so `docker compose up` fails with a named error
# until each one is filled in. An example that starts successfully with
# placeholder values is an example that reaches production unedited.

# --- Required ---------------------------------------------------------------

# Public hostname. Must already resolve to this host: Caddy requests a
# certificate for it on first start, and an unresolvable name fails the ACME
# challenge rather than falling back to plaintext.
MWP_DOMAIN=

# Contact address for the Let's Encrypt account. Used for expiry warnings.
MWP_ACME_EMAIL=

# The MUD this proxy fronts, under the default TARGET_MODE=fixed.
MWP_TN_HOST=

# --- Optional ---------------------------------------------------------------

# Defaults to 4000.
#MWP_TN_PORT=4000

# fixed (default) restricts every client to MWP_TN_HOST:MWP_TN_PORT.
# allowlist and arbitrary open that up and carry their own requirements —
# arbitrary additionally demands authentication and an explicit port list.
# See docs/configuration.md before changing this.
#MWP_TARGET_MODE=fixed

# Digest-pinned published image. Left unset, the stack builds from source.
#MWP_IMAGE=ghcr.io/andrewgoldfinch/mud-web-proxy@sha256:...
