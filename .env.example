# MUDBasher Proxy Configuration
# Copy this file to .env and customize
# Never commit .env files with real credentials!

# ============================================
# Core Server Configuration
# ============================================

# WebSocket proxy port (default: 6200)
WS_PORT=6200

# Default MUD server hostname (used if not specified by client)
TN_HOST=muds.maldorne.org

# Default MUD server port
TN_PORT=5010

# Inbound TLS. `required` terminates TLS here and needs TLS_CERT_PATH and
# TLS_KEY_PATH to exist; `off` serves plain HTTP and is only appropriate
# behind a reverse proxy that terminates TLS for you.
#
# Replaces DISABLE_TLS and ALLOW_INSECURE_PRODUCTION_NO_TLS, which now abort
# startup rather than being silently ignored.
INBOUND_TLS_MODE=required

# Address to bind. Defaults to loopback; behind a reverse proxy that is what
# you want. Binding a non-loopback address with INBOUND_TLS_MODE=off requires
# ALLOW_INSECURE_INBOUND_NO_TLS=true as an explicit acknowledgment.
BIND_HOST=127.0.0.1

# Optional explicit TLS paths. Defaults to ./cert.pem and ./privkey.pem.
# TLS_CERT_PATH=/etc/letsencrypt/live/proxy.example.com/fullchain.pem
# TLS_KEY_PATH=/etc/letsencrypt/live/proxy.example.com/privkey.pem

# Required to serve plaintext on a non-loopback address, for reverse-proxy TLS
# termination only. (The retired ALLOW_INSECURE_PRODUCTION_NO_TLS aborts
# startup; this is the variable that works.)
# ALLOW_INSECURE_INBOUND_NO_TLS=false

# ============================================
# Apple Push Notification Service (APNS)
# ============================================
#
# OPTIONAL and DISABLED by default. Leave these empty unless you are running
# an iOS client that needs push notifications; a browser client does not.
#
# All four of APNS_KEY_PATH, APNS_KEY_ID, APNS_TEAM_ID and APNS_TOPIC must be
# set together. Setting some but not all is a startup error rather than a
# half-configured manager that fails every push at Apple.
#
# Privacy: enabling push means device tokens are stored in memory alongside
# sessions and sent to Apple, and alert pushes carry a snippet of MUD output
# through Apple's servers. See docs/open-source-plan.md for the full note.

# Path to AuthKey.p8 file
APNS_KEY_PATH=

# APNS key ID
APNS_KEY_ID=

# Apple Developer Team ID
APNS_TEAM_ID=

# Bundle identifier (e.g., com.yourcompany.mudbasher)
APNS_TOPIC=

# Environment: sandbox or production. Not a switch on its own — it does
# nothing unless the four variables above are set.
APNS_ENVIRONMENT=sandbox

# Optional background push tuning
# SILENT_PUSH_INTERVAL_MS=1200000
# ACTIVITY_PUSH_INTERVAL_MS=120000
# ACTIVITY_PUSH_ACK_TIMEOUT_MS=15000
# ACTIVITY_PUSH_FALLBACK_COOLDOWN_MS=60000
# ACTIVITY_PUSH_FALLBACK_MAX_PER_HOUR=6
# ACTIVITY_PUSH_MAX_SNIPPET_LENGTH=100

# ============================================
# E2E Test Configuration
# ============================================

# Test timeout in milliseconds
TEST_TIMEOUT_MS=30000

# Proxy port for E2E tests
TEST_PROXY_PORT=6299

# Mock MUD server port
TEST_MOCK_PORT=6301

# CI environment detection
# Set to '1' to force mock MUD usage, '0' for real MUD, or 'auto' to detect
USE_MOCK_MUD=auto

# Skip E2E tests (set to '1' to skip)
SKIP_E2E_TESTS=0

# ============================================
# Development / Debug
# ============================================

# Enable debug logging (1=true, 0=false)
DEBUG=0

# TLS to the upstream MUD.
#   plain    - never attempt TLS
#   prefer   - attempt TLS, fall back to plaintext if the MUD does not speak
#              it. This is the default and matches previous behaviour, but an
#              active network attacker can force the fallback, so it is not
#              suitable where credentials cross the link.
#   required - TLS only. Never falls back, including when the peer closes
#              mid-handshake, which is the attacker's lever.
# MUD_TLS_MODE=prefer

# Which targets clients may reach.
#   fixed     - only TN_HOST:TN_PORT
#   allowlist - only exact host:port entries in ALLOWED_TARGETS
#   arbitrary - not yet supported; requires MWP-85 and MWP-88
#
# Replaces ONLY_ALLOW_DEFAULT_SERVER, which now aborts startup.
TARGET_MODE=fixed

# Required when TARGET_MODE=allowlist. Comma-separated host:port entries.
# An empty or unparseable list is a startup error, not a permissive default.
# ALLOWED_TARGETS=aardmud.org:4000,achaea.com:23

# Trusted reverse-proxy addresses. Empty means forwarded client-IP headers
# are ignored entirely, which is correct for a directly-exposed process.
# Set this to your reverse proxy's address, and make sure that proxy
# OVERWRITES X-Forwarded-For and X-Real-IP rather than appending.
# TRUSTED_PROXY_CIDRS=127.0.0.1

# Authentication. `none` (default) accepts any client that passes the origin
# check; `shared-secret` requires Authorization: Bearer <PROXY_SHARED_SECRET>.
# AUTH_MODE=none
# PROXY_SHARED_SECRET=

# Browsers cannot set headers on a WebSocket, so the secret may also be
# passed as ?secret=. That puts it in access logs and referrers, so it is
# opt-in.
# AUTH_ALLOW_QUERY_SECRET=false

# Optional diagnostics. Set both values to enable /diagnostic and
# /diagnostic/api with x-admin-token or Authorization: Bearer authentication.
ENABLE_DIAGNOSTICS=false
ADMIN_TOKEN=

# ─── App Authentication (Apple App Attest) ────────────────────────────────────
#
# OPTIONAL, DISABLED by default, and EXPERIMENTAL. Leave this whole section
# commented out unless you ship an iOS app: App Attest is Apple-device-only
# and does nothing for a browser client.
#
# EXPERIMENTAL: the Apple attestation and assertion verification in
# src/app-attest.ts has NOT received an independent cryptographic review. Do
# not rely on it as your only access control. Pair it with
# AUTH_MODE=shared-secret.
#
# Setting both identifiers is what enables the feature — there is no separate
# on/off flag. While unset, /attest/challenge and /attest/register are not
# registered at all and return 404. Setting only one is a startup error.
# APPATTEST_BUNDLE_ID=com.example.yourapp
# APPATTEST_TEAM_ID=AAABBBCCC1

# Require a valid App Attest assertion on every WebSocket upgrade. Requires
# the two identifiers above; setting it without them aborts startup rather
# than rejecting every client.
# REQUIRE_APP_AUTH=true

# Path to persist attested keys (default: ./config/attested-keys.json).
# Written atomically. Entries unused for 90 days are reclaimed, and the store
# is capped at 10,000 keys.
# ATTESTED_KEYS_PATH=./config/attested-keys.json

# ALLOW_MTLS_FALLBACK and MTLS_CLIENT_CA_PATH have been REMOVED. Client
# certificates are no longer accepted in place of an App Attest assertion —
# the fallback was active whenever NODE_ENV was not exactly "production",
# which includes unset. Startup aborts if either name is still present. For
# clients that cannot attest, use AUTH_MODE=shared-secret.
