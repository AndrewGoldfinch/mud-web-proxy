# Build output and dependencies
dist/
node_modules/
coverage/

# Lockfiles are tool-owned
bun.lock

# Agent worktrees live under .claude/ and are separate checkouts. Formatting
# there reaches into another working tree — prettier does not read
# .git/info/exclude, so it must be told separately.
.claude/

# The same applies to the other two agent-owned trees. `.worktrees/` holds
# linked worktrees — separate checkouts of this repository — and
# `.superpowers/` is an agent workspace that self-ignores through its own
# .gitignore. Both are invisible to git here but not to prettier, so
# `bun run format` fails locally on files CI never sees.
.worktrees/
.superpowers/

# Vendored third-party source: the anti-slop oxlint plugin is copied in by the
# install-anti-slop skill and is replaced wholesale on upgrade. Reformatting it
# to this repo's style would produce a diff against every future re-copy.
# .oxlintrc.json ignores the same path so the plugin does not lint itself.
tools/oxlint/anti-slop/

# Runtime state the app writes, not source. The shutdown flush (MWP-96) creates
# this on every clean exit, so without this entry anyone who starts and stops the
# server locally fails `bun run format`. Gitignored, but prettier does not read
# .gitignore.
config/attested-keys.json
